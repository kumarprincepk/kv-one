{
  "name": "kv-one",
  "version": "1.1.0",
  "description": "A runtime-adaptive, framework-agnostic Key-Value store for Browser, Node.js, and Cloudflare Workers — one API everywhere.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "dev": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "kv",
    "key-value",
    "key-value-store",
    "storage",
    "universal",
    "edge",
    "cloudflare",
    "cloudflare-workers",
    "cloudflare-kv",
    "browser",
    "node",
    "nodejs",
    "ttl",
    "cache",
    "caching",
    "localStorage",
    "sessionStorage",
    "runtime-agnostic",
    "framework-agnostic",
    "async",
    "typescript",
    "zero-dependency",
    "react",
    "useKV",
    "namespacing",
    "expiry",
    "persistent-storage",
    "isomorphic",
    "ssr-safe",
    "edge-runtime"
  ],
  "author": "Prince Kumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumarprincepk/kv-one.git"
  },
  "bugs": {
    "url": "https://github.com/kumarprincepk/kv-one/issues"
  },
  "homepage": "https://github.com/kumarprincepk/kv-one#readme",
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^9.25.1",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup": "^4.40.1",
    "rollup-plugin-dts": "^6.2.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
